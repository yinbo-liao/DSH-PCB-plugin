{
  "name": "@yinbo-liao/dsh-pcb",
  "version": "0.1.0",
  "description": "PCB design verification harness for DeepSeek Harness: packets, evidence ledger, independent gate monitor and a deterministic geometry DRC",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./src/*": "./src/*"
  },
  "files": [
    "index.js",
    "src/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness", "dsh", "dsh-plugin", "pcb", "hardware", "eda", "kicad", "drc", "verification"
  ],
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:sandbox": "node --test --test-isolation=none \"test/*.test.js\"",
    "test:sdk": "node test/sdk.integration.test.js"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-tools": { "optional": true }
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  }
}